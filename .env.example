# ============================================
# Curiosity Trail 环境变量示例
# ============================================
# 复制成 .env 后按需填写：cp .env.example .env
#
# 后端会依次读取两个位置（都不存在时用默认值）：
#   web/.env      ← 本地开发放这里
#   ./.env        ← 仓库根目录，等价
#
# .env 已在 .gitignore 中，不会被提交。
# 生产环境不要用 .env，改用部署脚本生成 deploy/.env.production
# （权限 600，由 deploy/deploy.sh 自动写入随机密码与 JWT 密钥）。
#
# 完整说明见 web/.env.example。
# ============================================

# ---- 鉴权（必填）----
# 登录密码。留空则首次启动时在 DATA_DIR 下生成随机密码。
APP_PASSWORD=

# 密码校验用的盐。留空则自动生成并存到 DATA_DIR/.app-password-salt
APP_PASSWORD_SALT=

# 会话签名密钥。留空则自动生成并存到 DATA_DIR/.session-secret
JWT_SECRET=

# ---- AI ----
# DeepSeek key。对话端点与搜索端点（/v1/tools/search、/v1/tools/fetch）共用这一把。
# 也可以不配，改在网页「设置 → AI 供应商」里填，会存进 DATA_DIR/ai-config.json。
DEEPSEEK_API_KEY=

# 本地 Ollama 兜底（DeepSeek 未配时启用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- 运行时 ----
# 监听端口。本地开发用 3001，容器里用 8080。
PORT=3001

# 数据目录：SQLite 库、上传图片、导入文档、备份都落在这里。
# 容器里必须指向挂载卷，否则重建就丢数据。
# 留空则用仓库根目录下的 data/。注意不要写成空值再取消注释——
# 空字符串会被当成"当前目录"，库文件会落在意料之外的位置。
# DATA_DIR=/app/data

# 会话有效期（天）。"保持登录"用的是 SESSION_REMEMBER_TTL_DAYS。
SESSION_TTL_DAYS=30
SESSION_REMEMBER_TTL_DAYS=90

# 每日自动备份时刻（0-23）。-1 关闭。
BACKUP_HOUR=3

# 异地备份目录。备份会额外复制一份到这里（与数据库不同盘才算真异地）。
# 留空则不启用。
# BACKUP_OFFSITE_DIR=/app/offsite
# BACKUP_OFFSITE_KEEP=30
