# 复制成 .env 后填入真实值。.env 已被 .gitignore 忽略，不要提交。

# 火山方舟的 embedding 接入凭据。这个账号下所有文本 embedding 模型
# （doubao-embedding-text-*、large-text-*）都已 Retiring 且无调用权限，
# 唯一可用的是 vision 模型。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215
# vision 模型只接受 multimodal 接口，且一次请求只返回一个融合向量。
# 保持 multimodal，不要改成 text。
ARK_EMBEDDING_INPUT=multimodal
ARK_EMBEDDING_DIM=2048

# 索引数据目录（AGFS 文件 + 向量库），相对本目录。派生数据，可随时重建。
VIKING_DATA_DIR=../../data/viking

# sidecar 自己的 HTTP 端口，只监听 127.0.0.1。
VIKING_PORT=8019

# openviking 内置的 AGFS 文件服务端口。它是子进程，端口独占，
# 不能和 VIKING_PORT 相同，也不能和本机其它服务冲突。
VIKING_AGFS_PORT=8018

# 单条向量化的超时（秒）。Ark 网络抖动时快速失败比长时间挂起好。
VIKING_EMBED_TIMEOUT_SECONDS=10

# 写入等待向量生成完成的超时（秒）。
VIKING_INDEX_TIMEOUT_SECONDS=8

VIKING_LOG_LEVEL=WARNING
