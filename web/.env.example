# 后端环境变量示例
#
# 复制成 .env 后按需填写：cp .env.example .env
# .env 不会被提交（已在 .gitignore 里）。
#
# 生产环境不要用 .env，改用平台 secret 注入：
#   fly secrets set JWT_SECRET=... DEEPSEEK_API_KEY=... ALIYUN_SMS_ACCESS_KEY_ID=...

# ---- 鉴权 ----
# 登录方式：手机号 + 短信验证码，首次登录自动注册。没有共享密码。
# 会话签名密钥。留空则自动生成并存到 DATA_DIR/.session-secret
JWT_SECRET=

# ---- 阿里云短信 ----
# 四项齐全才会真的发短信；缺任意一项，生产环境将无法登录（开发模式除外）。
# 模板需包含变量 ${code}，例如：「您的验证码为${code}，5分钟内有效。」
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 开发用固定验证码。仅在 NODE_ENV !== production 时生效，
# 设置了它就不会真的调用阿里云短信（本地开发、测试用）。
SMS_DEV_CODE=000000

# ---- AI ----
# DeepSeek key。对话端点与搜索端点（/v1/tools/search、/v1/tools/fetch）共用这一把。
# 也可以不配，改在网页「设置 → AI 供应商」里填，会存进 DATA_DIR/ai-config.json。
DEEPSEEK_API_KEY=

# 本地 Ollama 兜底（DeepSeek 未配时启用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- 长期记忆（viking sidecar）----
# 记忆服务是一个跑在 127.0.0.1 的 Python sidecar（web/memory-service）。
# 它没启动时整个记忆层关闭，对话与写作照常——所以这里没有"必须可达"的校验。
# 部署方法见 web/memory-service/README.md。

# 总开关。设为 false 则完全不启用长期记忆（召回归零、停止索引）。
MEMORY_ENABLED=true

# sidecar 地址。默认与 sidecar 自己的 VIKING_PORT 一致。
VIKING_BASE_URL=http://127.0.0.1:8019

# 召回超时（毫秒）。超时后放弃本次召回，对话照常继续。
VIKING_TIMEOUT_MS=800

# 写入超时（毫秒）。写入是后台任务，可以比召回宽松。
VIKING_INDEX_TIMEOUT_MS=10000

# 索引并发。openviking 遇到同名目录会失败，写入走队列串行化。
MEMORY_INDEX_CONCURRENCY=2

# 每次召回从 sidecar 取多少块候选（粗筛后的条数）。
MEMORY_TOP_K=16

# 注入上下文的上限：条数与总字数。聊天用下面两个，行内召回另有一套更紧的。
MEMORY_MAX_REFS=8
MEMORY_MAX_CHARS=3000

# 相似度阈值。低于这个分的候选直接丢弃。
# 取值依据见 scripts/calibrate-memory.js 的标定输出（真实库 + 6 万字稿件）。
MEMORY_MIN_SCORE=0.24

# 是否自动从对话里抽取事实入库。关掉后只有手动「记入记忆」会写进记忆库。
MEMORY_EXTRACT_ENABLED=true

# 索引失败后的首次退避时长（毫秒），后面的重试按 2 的幂往上翻。
MEMORY_RETRY_BASE_MS=1000

# ---- 运行时 ----
# 监听端口。Fly.io 上用 8080，本地开发用 3001。
PORT=3001

# 数据目录：SQLite 库、上传图片、导入文档、备份都落在这里。
# 容器里必须指向挂载卷，否则重建就丢数据。
# 留空则用仓库根目录下的 data/。注意不要写成空值再取消注释——
# 空字符串会被当成"当前目录"，库文件会落在意料之外的位置。
# DATA_DIR=/app/data

# 会话有效期（天）。"保持登录"用的是 SESSION_REMEMBER_TTL_DAYS。
SESSION_TTL_DAYS=30
SESSION_REMEMBER_TTL_DAYS=90

# 每日自动备份时刻（0-23）。-1 关闭。
BACKUP_HOUR=3

# 允许多实例共用同一个数据目录。默认关闭——
# SQLite 不支持多进程并发写，开着等于拿数据库冒险。
# ALLOW_MULTI_INSTANCE=1
