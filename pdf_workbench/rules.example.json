{
  "version": 1,
  "use_outline": true,
  "outline_levels": [1, 2],
  "rules": [
    {
      "name": "开票申请单",
      "type": "keyword",
      "pattern": "开票申请单",
      "scope": "top",
      "top_chars": 200,
      "name_from": "rule"
    },
    {
      "name": "费用签审单",
      "type": "keyword",
      "pattern": "费用签审单",
      "scope": "top",
      "top_chars": 200,
      "name_from": "rule"
    },
    {
      "name": "费用结算明细",
      "type": "keyword",
      "pattern": "费用结算明细",
      "scope": "top",
      "top_chars": 200,
      "name_from": "rule"
    },
    {
      "name": "模拟发票",
      "type": "keyword",
      "pattern": "模拟发票",
      "scope": "page",
      "name_from": "rule"
    },
    {
      "name": "工作确认单",
      "type": "keyword",
      "pattern": "工作确认单",
      "scope": "top",
      "top_chars": 200,
      "name_from": "rule"
    },
    {
      "name": "完工报告",
      "type": "keyword",
      "pattern": "完工报告",
      "scope": "top",
      "top_chars": 200,
      "name_from": "rule"
    },
    {
      "name": "服务通知单",
      "type": "keyword",
      "pattern": "服务通知单",
      "scope": "top",
      "top_chars": 200,
      "name_from": "rule"
    },
    {
      "name": "验收申请",
      "type": "keyword",
      "pattern": "验收申请",
      "scope": "top",
      "top_chars": 200,
      "name_from": "rule"
    },
    {
      "name": "人员考勤",
      "type": "keyword",
      "pattern": "人员考勤",
      "scope": "top",
      "top_chars": 200,
      "name_from": "rule"
    },
    {
      "name": "项目成果页",
      "type": "keyword",
      "pattern": "项目成果页",
      "scope": "top",
      "top_chars": 200,
      "name_from": "rule"
    },
    {
      "name": "合同关键页",
      "type": "regex",
      "pattern": "^\\s*合同(关键页|编号)\\s*[:：]?\\s*(.+)$",
      "scope": "top",
      "top_chars": 200,
      "name_from": "group"
    },
    {
      "name": "中文章节",
      "type": "regex",
      "pattern": "^\\s*第[一二三四五六七八九十百零\\d]+[章节篇部]",
      "scope": "top",
      "top_chars": 200,
      "name_from": "line"
    },
    {
      "name": "编号标题",
      "type": "regex",
      "pattern": "^\\s*\\d{1,2}(\\.\\d{1,2}){0,2}\\s+\\S",
      "scope": "top",
      "top_chars": 200,
      "name_from": "line"
    }
  ],
  "options": {
    "case_sensitive": false,
    "strip_whitespace": true,
    "exclude": "(续\\s*\\d*|第\\s*\\d+\\s*页|（续）|\\(续)",
    "orphan_pages": "prepend",
    "orphan_name": "前言",
    "filename": "{index:02d}_{name}.pdf",
    "name_max_len": 60
  }
}
