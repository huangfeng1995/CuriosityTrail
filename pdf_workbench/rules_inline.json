    },
    {
      "name": "工作确认单",
      "type": "keyword",
      "pattern": "工作确认单",
      "scope": "page",
      "inline": true,
      "name_from": "rule"
    },
    {
      "name": "完工报告",
      "type": "keyword",
      "pattern": "完工报告",
      "scope": "page",
      "inline": true,
      "name_from": "rule"
    },
    {
      "name": "服务通知单",
      "type": "keyword",
