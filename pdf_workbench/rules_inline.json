  "options": {
    "case_sensitive": false,
    "strip_whitespace": true,
    "exclude": "(续\\s*\\d*|第\\s*\\d+\\s*页|（续）|\\(续)",
    "orphan_pages": "prepend",
    "orphan_name": "前言",
    "inline_split": true,
    "head_ratio": 0.15,
    "min_tail": 30,
    "inline_padding": 2,
    "merge_blank_runs": true,
    "filename": "{index:02d}_{name}.pdf",
    "name_max_len": 60
  }
