# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Project specific - 数据目录不要提交
data/
documents/
*.db

# 本地版打包产物（给非技术用户用的 zip）
dist-local/

# Environment variables - 敏感配置不要提交
.env
.env.local
.env.*.local

# 生产环境变量（deploy/deploy.sh 自动生成，含登录密码与 JWT 密钥）
deploy/.env.production
# 记忆服务 sidecar 的 ARK key（同样由 deploy.sh 生成，不进版本库）
deploy/.env.memory
# 记忆服务的本地开发配置
web/memory-service/.env

# 异地备份暂存目录
data-offsite/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# PyInstaller
*.manifest
*.spec

# Backup files
*.zip.backup

# PDF 原型工作台的测试产物（源码已入库，产物不入库）
pdf_workbench/output/
pdf_workbench/*.txt
